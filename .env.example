# OpenRouter is called only from Agent's server-side runtime.
#
# Settings → Integrations stores the same credential in
# app-data/state/openrouter.key and applies it without a restart. This
# variable wins when both exist: remove it here to use the stored key.
OPENROUTER_API_KEY=

# Optional default model ID for the Settings → Models test panel.
OPENROUTER_MODEL=

# EVE agent runtime. The host spawns `eve dev` from the agent project on
# every boot; these only override where it looks and what it binds to.
AGENT_EVE_ROOT=./my-agent
AGENT_EVE_PORT=2000
AGENT_EVE_URL=http://127.0.0.1:2000

# Persistent Agent state (SQLite database, memory and personality files).
AGENT_STATE_DIR=./app-data/state

# The wake service: a separate process that runs the microphone detector.
# The wake lab at /wake reaches it over these addresses; both default to the
# local service.
AGENT_WAKE_WS_URL=ws://127.0.0.1:8787/ws/audio
AGENT_WAKE_URL=http://127.0.0.1:8787

# The secret both processes sign the host's session with. The host mints a
# token for the signed-in user; the service verifies it. It must be the same
# value on both sides and at least 32 characters, or the wake lab says it is
# not configured rather than failing later in a way nobody can read.
AGENT_WAKE_TOKEN_SECRET=
