# OpenRouter is called only from Lexia's server-side runtime.
OPENROUTER_API_KEY=

# Optional default model ID for the Settings → Models test panel.
OPENROUTER_MODEL=

# EVE agent runtime. The host spawns `eve dev` from the agent project on
# every boot; these only override where it looks and what it binds to.
LEXIA_EVE_ROOT=./my-agent
LEXIA_EVE_PORT=2000
LEXIA_EVE_URL=http://127.0.0.1:2000

# Persistent Lexia state (SQLite database, memory and personality files).
LEXIA_STATE_DIR=./app-data/state
