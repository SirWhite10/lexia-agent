# Agent runtime output. The structure of an agent directory is authored and
# tracked; what the host writes into it is not. Recursive, because `subagents/`
# holds one directory per standing sub-agent with the same shape.
agents/default/**/cache/*
agents/default/**/logs/*
agents/default/**/plugins/versions/*
!**/.gitkeep

